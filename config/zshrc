# Generated by omamac. Changes here are overwritten; put your own in ~/.zshrc.
[[ ":$PATH:" == *":$HOME/.local/share/omamac/bin:"* ]] || export PATH="$HOME/.local/share/omamac/bin:$PATH"

# Only raise the sizes: a smaller value would make zsh trim the user's history file.
(( HISTSIZE >= 10000 )) || HISTSIZE=10000
(( SAVEHIST >= 20000 )) || SAVEHIST=20000
setopt append_history hist_ignore_dups hist_ignore_space

if (( $+commands[nvim] )); then
  export EDITOR=nvim
  export VISUAL=nvim
fi

# herdr can't include another file, so point it at omamac's own when the user has none.
# A file holding only "onboarding = false" is one herdr wrote itself, not the user's.
if (( ! ${+HERDR_CONFIG_PATH} )) && [[ ! -L ~/.config/herdr/config.toml ]] &&
  [[ ! -e ~/.config/herdr/config.toml || $(<~/.config/herdr/config.toml) == 'onboarding = false' ]]; then
  export HERDR_CONFIG_PATH=~/.config/omamac/herdr.toml
fi

# starship and btop can't include another file either: same rule as herdr.
if (( ! ${+STARSHIP_CONFIG} )) && [[ ! -e ~/.config/starship.toml && ! -L ~/.config/starship.toml ]]; then
  export STARSHIP_CONFIG=~/.config/omamac/starship.toml
fi
if (( $+commands[btop] )) && [[ ! -e ~/.config/btop/btop.conf && ! -L ~/.config/btop/btop.conf ]]; then
  alias btop='btop -c ~/.config/omamac/btop.conf --themes-dir ~/.config/omamac/btop-themes'
fi

# Homebrew's completions only load if their folder is on fpath before compinit.
(( ${fpath[(Ie)/opt/homebrew/share/zsh/site-functions]} )) || fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
# Skip compinit when the user's own ~/.zshrc already ran it.
(( $+functions[compdef] )) || { autoload -Uz compinit && compinit; }
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
# zle only exists in a terminal; without this guard a script run warns.
if [[ -o zle ]]; then
  autoload -U up-line-or-beginning-search down-line-or-beginning-search
  zle -N up-line-or-beginning-search
  zle -N down-line-or-beginning-search
  bindkey '^[[A' up-line-or-beginning-search
  bindkey '^[[B' down-line-or-beginning-search
  # Application keypad mode sends ^[OA instead; terminfo knows which one this terminal uses.
  [[ -n ${terminfo[kcuu1]} ]] && bindkey "${terminfo[kcuu1]}" up-line-or-beginning-search
  [[ -n ${terminfo[kcud1]} ]] && bindkey "${terminfo[kcud1]}" down-line-or-beginning-search
fi

if (( $+commands[eza] )); then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias ll='eza -la'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
  alias tree='eza --tree'
else
  alias ll='ls -la'
fi

(( $+commands[bat] )) && alias cat='bat --paging=never'

if (( $+commands[fzf] && $+commands[bat] )); then
  alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
fi

(( $+commands[zoxide] )) && { eval "$(zoxide init zsh)"; alias cd='z'; }

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

(( $+commands[fzf] )) && source <(fzf --zsh)

if (( $+commands[git] )); then
  alias g='git'
  alias gcm='git commit -m'
  alias gcam='git commit -a -m'
  alias gcad='git commit -a --amend'
fi

(( $+commands[docker] )) && alias d='docker'
(( $+commands[lazygit] )) && alias lzg='lazygit'
(( $+commands[lazydocker] )) && alias lzd='lazydocker'

if (( $+commands[nvim] )); then
  # Drop a user alias `n` first: `n()` is a parse error with one, and an alias hides a function.
  (( $+aliases[n] )) && unalias n
  function n { if (( $# == 0 )); then nvim .; else nvim "$@"; fi; }
fi

(( $+commands[mise] )) && eval "$(mise activate zsh)"
# rails only comes onto the PATH once mise has activated, so check after it.
(( $+commands[rails] )) && alias r='rails'

# Starship goes last, as its docs ask, so it sees what the hooks above set.
# An if, so the file's exit status is 0 when starship is missing.
if (( $+commands[starship] )); then eval "$(starship init zsh)"; fi
