# omamac's saved answers. omamac reads this file as data; it is never run.
theme=catppuccin
apps_browsers=brave chrome firefox
apps_communication=whatsapp telegram signal discord slack zoom
apps_media=spotify vlc
apps_screen_recording=cap
apps_storage=dropbox google-drive
apps_developer=vscode
apps_ai=claude chatgpt copilot antigravity
apps_productivity=raycast obsidian
wispr_flow=yes
desktops=yes
window_margins=yes
desktop_widgets=yes
dock=yes
dock_autohide=yes
tap_to_click=yes
three_finger_drag=yes
languages=ruby node go python elixir rust java
cloud_clis=azure aws gcloud gh terraform
# Not codex or copilot-cli: their casks run the binary during brew install,
# and in the VM macOS's first-launch check of it never finishes. On a real
# Mac both install in seconds (checked 2026-11-21); Gate B picks them.
coding_agents=claude-code antigravity-cli opencode
docker=docker-desktop
