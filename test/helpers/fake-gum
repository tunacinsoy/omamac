#!/bin/bash
# Test double for gum. Bash 3.2 safe.
case "${1:-}" in
  style)
    shift
    # Print the text args; flags are skipped (tests pass them as --flag=value).
    for a in "$@"; do
      case "$a" in -*) ;; *) echo "$a" ;; esac
    done
    ;;
  spin)
    # Log the call, so tests can tell what ran under a spinner.
    [ -z "${STUB_LOG:-}" ] || echo "gum $*" >> "$STUB_LOG"
    shift
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do shift; done
    [ $# -eq 0 ] || shift
    "$@"
    ;;
  choose | confirm)
    # Log the call, check the prompt reads the (fake) terminal, then answer
    # from the queue in T_GUM_ANSWERS: one line per prompt.
    [ -z "${STUB_LOG:-}" ] || echo "gum $*" >> "$STUB_LOG"
    IFS= read -r first || first=''
    if [ "$first" != fake-tty ]; then
      echo "fake-gum: prompt not reading the tty" >&2
      exit 98
    fi
    queue="${T_GUM_ANSWERS:-/nonexistent}"
    pos=$(cat "$queue.pos" 2>/dev/null || echo 0)
    pos=$((pos + 1))
    if [ ! -f "$queue" ] || [ "$pos" -gt "$(wc -l < "$queue")" ]; then
      echo "fake-gum: no answer for prompt $pos" >&2
      exit 99
    fi
    echo "$pos" > "$queue.pos"
    answer=$(sed -n "${pos}p" "$queue")
    case "$answer" in
      "exit "*) exit "${answer#exit }" ;;
    esac
    if [ "$1" = confirm ]; then
      [ "$answer" = yes ]
      exit
    fi
    # choose prints one value per line; an empty answer prints nothing.
    for v in $answer; do echo "$v"; done
    ;;
  *) echo "$@" ;;
esac
