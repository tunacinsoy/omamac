#!/bin/bash
# Test double for Homebrew. Bash 3.2 safe. Prefix comes from OMAMAC_TEST_BREW_PREFIX.
prefix="${OMAMAC_TEST_BREW_PREFIX:?fake-brew needs OMAMAC_TEST_BREW_PREFIX}"
[ -z "${STUB_LOG:-}" ] || echo "brew $*" >> "$STUB_LOG"

# fake_cask_app <cask>: the app it puts in Applications, for Ghostty, Docker
# Desktop and every cask in apps/; nothing for any other cask.
fake_cask_app() {
  local f
  case "$1" in
    ghostty) echo Ghostty.app ;;
    docker-desktop) echo Docker.app ;;
    *)
      for f in "${REPO_ROOT:?fake-brew needs REPO_ROOT}"/apps/*; do
        if [ "$(sed -n 's/^cask=//p' "$f")" = "$1" ]; then sed -n 's/^app=//p' "$f"; fi
      done
      ;;
  esac
}

# fake_cask <cask>: the Caskroom entry and its app.
fake_cask() {
  local app
  mkdir -p "$prefix/Caskroom/$1"
  app=$(fake_cask_app "$1")
  [ -z "$app" ] || mkdir -p "${OMAMAC_TEST_APPLICATIONS:?fake-brew needs OMAMAC_TEST_APPLICATIONS}/$app"
  # VS Code's code command is in the app.
  if [ "$1" = visual-studio-code ]; then
    mkdir -p "$OMAMAC_TEST_APPLICATIONS/$app/Contents/Resources/app/bin"
    ln -sf "$REPO_ROOT/test/helpers/fake-code" "$OMAMAC_TEST_APPLICATIONS/$app/Contents/Resources/app/bin/code"
  fi
}

# fake_versions <Cellar|Caskroom>: "name version" per entry, as brew list
# --versions prints; the version is in the entry's .version file, 1.0 otherwise.
fake_versions() {
  local d
  for d in "$prefix/$1"/*; do
    [ -e "$d" ] || continue
    echo "$(basename "$d") $(cat "$d/.version" 2>/dev/null || echo 1.0)"
  done
}

case "${1:-}" in
  shellenv)
    echo "export PATH=\"$prefix/bin:\$PATH\""
    ;;
  list)
    if [ "${2:-}" = "--formula" ]; then
      [ "${T_BREW_LIST_FAIL:-0}" != 1 ] || { echo "Error: brew list failed" >&2; exit 1; }
      case "${3:-}" in
        --full-name)
          # A formula installed as a/b/c lists as a/b/c; its tap is in Cellar/c/.tap.
          for d in "$prefix"/Cellar/*; do
            [ -e "$d" ] || continue
            if [ -f "$d/.tap" ]; then echo "$(cat "$d/.tap")/$(basename "$d")"; else basename "$d"; fi
          done
          exit 0
          ;;
        '' | -1)
          for d in "$prefix"/Cellar/*; do
            [ -e "$d" ] && basename "$d"
          done
          exit 0
          ;;
        --versions) fake_versions Cellar; exit 0 ;;
        *) [ -e "$prefix/Cellar/$3" ]; exit ;;
      esac
    elif [ "${2:-}" = "--cask" ]; then
      [ "${T_BREW_LIST_FAIL:-0}" != 1 ] || { echo "Error: brew list failed" >&2; exit 1; }
      case "${3:-}" in
        '' | -1) ;;
        --versions) fake_versions Caskroom; exit 0 ;;
        *) [ -e "$prefix/Caskroom/$3" ]; exit ;;
      esac
      for d in "$prefix"/Caskroom/*; do
        [ -e "$d" ] && basename "$d"
      done
      exit 0
    elif [ "${2:-}" = "--pinned" ]; then
      [ ! -f "$prefix/pinned" ] || cat "$prefix/pinned"
      exit 0
    elif [ "${2:-}" = "--versions" ]; then
      for d in "$prefix"/Cellar/*; do
        [ -e "$d" ] && echo "$(basename "$d") 1.0"
      done
      exit 0
    fi
    ;;
  install)
    [ "${T_BREW_FAIL:-0}" != 1 ] || { echo "Error: brew install failed" >&2; exit 1; }
    [ $# -ge 2 ] || { echo "brew install needs a formula" >&2; exit 1; }
    shift
    root=Cellar
    if [ "${1:-}" = "--cask" ]; then root=Caskroom; shift; fi
    # --adopt: like Homebrew, the app already in Applications stays as it is;
    # fake_cask only makes the folder when it's missing. The call log records the flag.
    [ "${1:-}" != --adopt ] || shift
    for f in "$@"; do
      if [ "$root" = Caskroom ]; then
        # A dropped download: the cask fails before Homebrew records it.
        [ "$f" != "${T_BREW_FAIL_CASK:-}" ] || { echo "Error: Download failed on Cask '$f'" >&2; exit 1; }
        fake_cask "$f"
        continue
      fi
      # Like Homebrew: no two formulas with the same name from different taps.
      d="$prefix/Cellar/${f##*/}" tap=''
      case "$f" in */*/*) tap=${f%/*} ;; esac
      if [ -d "$d" ] && [ "$(cat "$d/.tap" 2>/dev/null)" != "$tap" ]; then
        echo "Error: Formulae with the same name from different taps cannot be installed at the same time." >&2
        exit 1
      fi
      case "$f" in
        */*/*)
          mkdir -p "$prefix/Cellar/${f##*/}"
          echo "${f%/*}" > "$prefix/Cellar/${f##*/}/.tap"
          continue
          ;;
      esac
      mkdir -p "$prefix/Cellar/$f" "$prefix/bin"
      case "$f" in
        bash) ln -sf "${BASH5:-/opt/homebrew/bin/bash}" "$prefix/bin/bash" ;;
        gum)  ln -sf "${HELPERS_DIR:?fake-brew needs HELPERS_DIR}/fake-gum" "$prefix/bin/gum" ;;
        mise) ln -sf "${HELPERS_DIR:?fake-brew needs HELPERS_DIR}/fake-mise" "$prefix/bin/mise" ;;
        colima) ln -sf "${HELPERS_DIR:?fake-brew needs HELPERS_DIR}/fake-colima" "$prefix/bin/colima" ;;
        # Like Homebrew: docker's plugins sit in the formula's opt folder.
        docker-compose | docker-buildx) mkdir -p "$prefix/opt/$f/bin" && : > "$prefix/opt/$f/bin/$f" ;;
      esac
    done
    ;;
  tap)
    [ "${T_BREW_TAP_FAIL:-0}" != 1 ] || { echo "Error: brew tap failed" >&2; exit 1; }
    if [ $# -eq 1 ]; then
      [ ! -f "$prefix/taps" ] || cat "$prefix/taps"
    else
      echo "$2" >> "$prefix/taps"
    fi
    ;;
  uninstall)
    shift
    root=Cellar
    if [ "${1:-}" = "--cask" ]; then root=Caskroom; shift; fi
    # --zap: the app goes as without it; the call log records the flag.
    [ "${1:-}" != --zap ] || shift
    for f in "$@"; do
      [ "${T_BREW_UNINSTALL_FAIL:-0}" != 1 ] || { echo "Error: $f is required by other" >&2; exit 1; }
      rm -rf "${prefix:?}/$root/${f##*/}"
      # Like Homebrew: a cask uninstall takes its app too.
      if [ "$root" = Caskroom ]; then
        app=$(fake_cask_app "$f")
        [ -z "$app" ] || rm -rf "${OMAMAC_TEST_APPLICATIONS:?}/$app"
      fi
    done
    ;;
  reinstall)
    # Like Homebrew: only a cask it lists; recreates the entry and the app.
    [ "${2:-}" = "--cask" ] || { echo "fake-brew: reinstall supports only --cask" >&2; exit 1; }
    for f in "${@:3}"; do
      [ -e "$prefix/Caskroom/$f" ] || { echo "Error: Cask '$f' is not installed." >&2; exit 1; }
      fake_cask "$f"
    done
    ;;
  upgrade)
    [ "${T_BREW_UPGRADE_FAIL:-0}" != 1 ] || [ "${2:-}" != --cask ] || { echo "Error: brew upgrade failed" >&2; exit 1; }
    # T_BREW_DOWNLOAD_MIB: a cask upgrade downloads that many MiB, as Homebrew
    # does, into a growing .incomplete file, in two halves 0.6 s apart.
    if [ -n "${T_BREW_DOWNLOAD_MIB:-}" ] && [ "${2:-}" = --cask ]; then
      d="$HOME/Library/Caches/Homebrew/downloads" f="$HOME/Library/Caches/Homebrew/downloads/abc--$3.incomplete"
      mkdir -p "$d"
      for _ in 1 2; do head -c $((T_BREW_DOWNLOAD_MIB * 524288)) /dev/zero >> "$f"; sleep 0.6; done
      mv "$f" "${f%.incomplete}"
    fi
    ;;
  services)
    # A registered service is the file $prefix/services/<formula>.
    f=${3:?fake-brew: services needs a formula}
    case "${2:-}" in
      info)
        [ "${T_BREW_SERVICES_INFO_FAIL:-0}" != 1 ] || { echo "Error: brew services info failed" >&2; exit 1; }
        # Like Homebrew: no formula, no service info.
        [ -d "$prefix/Cellar/$f" ] || { echo "Error: No available formula with the name \"$f\"." >&2; exit 1; }
        # The file may hold a status (error); a registered service is started otherwise.
        r=false st=none
        if [ -e "$prefix/services/$f" ]; then r=true st=$(cat "$prefix/services/$f"); [ -n "$st" ] || st=started; fi
        echo "[{\"name\":\"$f\",\"status\":\"$st\",\"registered\":$r}]"
        ;;
      start)
        [ "${T_BREW_SERVICES_FAIL:-0}" != 1 ] || { echo "Error: Failure while executing launchctl" >&2; exit 1; }
        # Like Homebrew: a second start exits 1.
        if [ -e "$prefix/services/$f" ]; then
          echo "Error: Service \`$f\` already started, use \`brew services restart $f\` to restart." >&2
          exit 1
        fi
        mkdir -p "$prefix/services" && : > "$prefix/services/$f"
        ;;
      stop)
        # Like Homebrew: stopping a service that isn't registered only warns.
        [ -e "$prefix/services/$f" ] || echo "Warning: Service \`$f\` is not started." >&2
        rm -f "$prefix/services/$f"
        ;;
      *) echo "fake-brew: unknown services command $*" >&2; exit 1 ;;
    esac
    ;;
  outdated)
    # --json=v2, doctor's one call: $prefix/outdated.json, or nothing outdated.
    if [[ " $* " == *" --json=v2 "* ]]; then
      # So tests can tell Homebrew wasn't asked to update itself first.
      [ -z "${STUB_LOG:-}" ] || echo "brew-env outdated HOMEBREW_NO_AUTO_UPDATE=${HOMEBREW_NO_AUTO_UPDATE:-}" >> "$STUB_LOG"
      [ -z "${T_BREW_OUTDATED_SLEEP:-}" ] || sleep "$T_BREW_OUTDATED_SLEEP"
      [ "${T_BREW_OUTDATED_FAIL:-0}" != 1 ] || { echo "Error: brew outdated failed" >&2; exit 1; }
      if [ -f "$prefix/outdated.json" ]; then cat "$prefix/outdated.json"; else echo '{"formulae":[],"casks":[]}'; fi
      exit 0
    fi
    # Like Homebrew: each named item that is outdated is printed, and the status is 1.
    status=0
    for name in "${@:2}"; do
      case "$name" in -*) continue ;; esac
      if [ -f "$prefix/outdated" ] && grep -qx "$name" "$prefix/outdated"; then
        echo "$name"
        status=1
      fi
    done
    exit "$status"
    ;;
esac
exit 0
