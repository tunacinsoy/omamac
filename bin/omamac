#!/opt/homebrew/bin/bash
# The omamac command.
# shellcheck source-path=SCRIPTDIR/..
set -Eeuo pipefail

OMAMAC_CHECKOUT=$(cd "$(dirname "$0")/.." && pwd -P)
# shellcheck source=lib/paths.sh
source "$OMAMAC_CHECKOUT/lib/paths.sh"
# shellcheck source=lib/lines.sh
source "$OMAMAC_CHECKOUT/lib/lines.sh"
# shellcheck source=lib/ui.sh
source "$OMAMAC_CHECKOUT/lib/ui.sh"
# shellcheck source=lib/questions.sh
source "$OMAMAC_CHECKOUT/lib/questions.sh"
# shellcheck source=lib/choices.sh
source "$OMAMAC_CHECKOUT/lib/choices.sh"
# shellcheck source=lib/ask.sh
source "$OMAMAC_CHECKOUT/lib/ask.sh"
# shellcheck source=lib/log.sh
source "$OMAMAC_CHECKOUT/lib/log.sh"
# shellcheck source=lib/core.sh
source "$OMAMAC_CHECKOUT/lib/core.sh"
# shellcheck source=lib/neovim.sh
source "$OMAMAC_CHECKOUT/lib/neovim.sh"
# shellcheck source=lib/herdr.sh
source "$OMAMAC_CHECKOUT/lib/herdr.sh"
# shellcheck source=lib/languages.sh
source "$OMAMAC_CHECKOUT/lib/languages.sh"
# shellcheck source=lib/clis.sh
source "$OMAMAC_CHECKOUT/lib/clis.sh"
# shellcheck source=lib/apply.sh
source "$OMAMAC_CHECKOUT/lib/apply.sh"
# shellcheck source=lib/add.sh
source "$OMAMAC_CHECKOUT/lib/add.sh"
# shellcheck source=lib/remove.sh
source "$OMAMAC_CHECKOUT/lib/remove.sh"
# shellcheck source=lib/doctor.sh
source "$OMAMAC_CHECKOUT/lib/doctor.sh"

OMAMAC_STEP='starting'
OMAMAC_CMD=''

# The ERR trap for install and uninstall. Not for doctor: it returns 1 on a ✗.
omamac_failed() {
  # With set -E the trap also runs inside ( … ) and $( … ); let only the main shell speak.
  [ "$BASHPID" -eq "$$" ] || exit 1
  ui_fail "omamac stopped while $OMAMAC_STEP."
  # install has saved the picks by now, so running it again wouldn't offer them.
  if [ "$OMAMAC_CMD" = install ]; then
    ui_fail "Fix the problem and run omamac update."
  else
    ui_fail "Fix the problem and run omamac $OMAMAC_CMD again."
  fi
  exit 1
}

# omamac_choices: load the saved answers, or stop. choices_load reads a
# missing file as no answers, but these commands have no first-run questions.
omamac_choices() {
  OMAMAC_STEP='reading your saved answers'
  if [ ! -e "$OMAMAC_CHOICES_FILE" ]; then
    ui_fail "omamac doesn't know your answers. Fix: run the one-liner."
    exit 1
  fi
  # choices_load has said what's wrong and how to fix it.
  choices_load "$OMAMAC_CHOICES_FILE" || exit 1
}

omamac_usage() {
  cat <<'USAGE'
Usage: omamac <command>

  install     Add tools and apps
  update      Update omamac and what it installed
  theme       Switch the theme everywhere
  doctor      Check that everything is healthy
  uninstall   Remove one thing omamac installed
USAGE
}

# omamac_update: pull the new code, then run its update.sh. exec, so the steps
# that run are the new ones, not this old copy's.
omamac_update() {
  local fix="omamac couldn't update its code. Fix: check your internet connection, or run git -C ~/.local/share/omamac status to see why."
  # pull --ff-only keeps local edits the new commits don't touch, so check
  # first: a checkout with local edits is left as it is.
  if [ -n "$(git -C "$OMAMAC_HOME" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    ui_fail "omamac's code has local edits, so update stopped. Fix: git -C ~/.local/share/omamac status, to see them."
    return 1
  fi
  # update.sh starts the run's real log; this one holds only git's output.
  # Not mktemp -t: on macOS it ignores TMPDIR. %/ drops TMPDIR's trailing slash.
  local OMAMAC_LOG tmp=${TMPDIR:-/tmp}
  OMAMAC_LOG=$(mktemp "${tmp%/}/omamac-pull.XXXXXX")
  if ! GIT_TERMINAL_PROMPT=0 ui_run "Updating omamac" git -C "$OMAMAC_HOME" pull --ff-only; then
    ui_fail "$fix"
    return 1
  fi
  rm -f "$OMAMAC_LOG"
  exec "$OMAMAC_BREW_PREFIX/bin/bash" "$OMAMAC_HOME/update.sh"
}

omamac_main() {
  local cmd=${1:-help}
  case "$cmd" in
    help | -h | --help) omamac_usage ;;
    doctor) doctor_run ;;
    update) omamac_update ;;
    install)
      if [ "$#" -gt 1 ]; then
        omamac_usage >&2
        return 2
      fi
      OMAMAC_CMD=install
      trap omamac_failed ERR
      omamac_choices
      add_run
      ;;
    uninstall)
      if [ "$#" -gt 2 ]; then
        omamac_usage >&2
        return 2
      fi
      OMAMAC_CMD=uninstall
      trap omamac_failed ERR
      omamac_choices
      remove_run "${@:2}"
      ;;
    theme)
      echo "omamac $cmd isn't available yet." >&2
      return 1
      ;;
    *)
      echo "Unknown command: $cmd" >&2
      omamac_usage >&2
      return 2
      ;;
  esac
}

omamac_main "$@"
