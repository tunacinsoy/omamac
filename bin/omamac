#!/opt/homebrew/bin/bash
# The omamac command.
# shellcheck source-path=SCRIPTDIR/..
set -Eeuo pipefail

OMAMAC_CHECKOUT=$(cd "$(dirname "$0")/.." && pwd -P)
# shellcheck source=lib/paths.sh
source "$OMAMAC_CHECKOUT/lib/paths.sh"
# shellcheck source=lib/lines.sh
source "$OMAMAC_CHECKOUT/lib/lines.sh"
# shellcheck source=lib/ui.sh
source "$OMAMAC_CHECKOUT/lib/ui.sh"
# shellcheck source=lib/questions.sh
source "$OMAMAC_CHECKOUT/lib/questions.sh"
# shellcheck source=lib/choices.sh
source "$OMAMAC_CHECKOUT/lib/choices.sh"
# shellcheck source=lib/ask.sh
source "$OMAMAC_CHECKOUT/lib/ask.sh"
# shellcheck source=lib/log.sh
source "$OMAMAC_CHECKOUT/lib/log.sh"
# shellcheck source=lib/core.sh
source "$OMAMAC_CHECKOUT/lib/core.sh"
# shellcheck source=lib/apps.sh
source "$OMAMAC_CHECKOUT/lib/apps.sh"
# shellcheck source=lib/neovim.sh
source "$OMAMAC_CHECKOUT/lib/neovim.sh"
# shellcheck source=lib/herdr.sh
source "$OMAMAC_CHECKOUT/lib/herdr.sh"
# shellcheck source=lib/ghostty.sh
source "$OMAMAC_CHECKOUT/lib/ghostty.sh"
# shellcheck source=lib/theme.sh
source "$OMAMAC_CHECKOUT/lib/theme.sh"
# shellcheck source=lib/vscode.sh
source "$OMAMAC_CHECKOUT/lib/vscode.sh"
# shellcheck source=lib/languages.sh
source "$OMAMAC_CHECKOUT/lib/languages.sh"
# shellcheck source=lib/clis.sh
source "$OMAMAC_CHECKOUT/lib/clis.sh"
# shellcheck source=lib/docker.sh
source "$OMAMAC_CHECKOUT/lib/docker.sh"
# shellcheck source=lib/appmanagement.sh
source "$OMAMAC_CHECKOUT/lib/appmanagement.sh"
# shellcheck source=lib/settings.sh
source "$OMAMAC_CHECKOUT/lib/settings.sh"
# shellcheck source=lib/dock.sh
source "$OMAMAC_CHECKOUT/lib/dock.sh"
# shellcheck source=lib/apply.sh
source "$OMAMAC_CHECKOUT/lib/apply.sh"
# shellcheck source=lib/add.sh
source "$OMAMAC_CHECKOUT/lib/add.sh"
# shellcheck source=lib/remove.sh
source "$OMAMAC_CHECKOUT/lib/remove.sh"
# shellcheck source=lib/doctor.sh
source "$OMAMAC_CHECKOUT/lib/doctor.sh"
# shellcheck source=lib/configure.sh
source "$OMAMAC_CHECKOUT/lib/configure.sh"
# shellcheck source=lib/menu.sh
source "$OMAMAC_CHECKOUT/lib/menu.sh"

OMAMAC_STEP='starting'
OMAMAC_CMD=''

# The ERR trap for install, uninstall, configure and theme. Not for doctor: it returns 1 on a ✗.
omamac_failed() {
  # With set -E the trap also runs inside ( … ) and $( … ); let only the main shell speak.
  [ "$BASHPID" -eq "$$" ] || exit 1
  # Once install has saved the picks, or configure a yes, running it again
  # wouldn't offer them; update applies what is saved.
  local saved=${ADD_SAVED:-}${CONFIGURE_SAVED:-}
  if ui_term; then
    if [ -n "$saved" ]; then ui_stopped "run omamac update"
    else ui_stopped "run omamac $OMAMAC_CMD again"; fi
    exit 1
  fi
  ui_fail "omamac stopped while $OMAMAC_STEP."
  if [ -n "$saved" ]; then
    ui_fail "Fix the problem and run omamac update."
  else
    ui_fail "Fix the problem and run omamac $OMAMAC_CMD again."
  fi
  exit 1
}

# omamac_choices: load the saved answers, or stop. choices_load reads a
# missing file as no answers, but these commands have no first-run questions.
omamac_choices() {
  OMAMAC_STEP='reading your saved answers'
  if [ ! -e "$OMAMAC_CHOICES_FILE" ]; then
    ui_fail "omamac doesn't know your answers. Fix: run the one-liner."
    exit 1
  fi
  # choices_load has said what's wrong and how to fix it.
  choices_load "$OMAMAC_CHOICES_FILE" || exit 1
}

omamac_usage() {
  cat <<'USAGE'
Usage: omamac <command>

With no command, omamac asks what you want to do. Each command
asks what it needs when you name nothing after it.

  install     Add apps, languages, cloud CLIs, coding agents or
              Docker: a section (apps, languages, cloud-clis,
              coding-agents, docker) or names: install go rust
  uninstall   Remove one thing omamac installed: uninstall vlc
  configure   Turn a macOS setting on or off (desktops,
              window-margins, desktop-widgets, dock, dock-autohide):
              configure dock-autohide on
  theme       Switch the theme everywhere
  update      Update omamac and what it installed
  doctor      Check that everything is healthy; doctor --all
              shows every check and what it is

All of them: docs/commands.md
USAGE
}

# omamac_update: pull the new code, then run its update.sh. exec, so the steps
# that run are the new ones, not this old copy's.
omamac_update() {
  local fix="omamac couldn't update its code. Fix: check your internet connection, or run git -C ~/.local/share/omamac status to see why."
  # pull --ff-only keeps local edits the new commits don't touch, so check
  # first: a checkout with local edits is left as it is.
  if [ -n "$(git -C "$OMAMAC_HOME" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    ui_fail "omamac's code has local edits, so update stopped. Fix: git -C ~/.local/share/omamac status, to see them."
    return 1
  fi
  # update.sh starts the run's real log; this one holds only git's output.
  # Not mktemp -t: on macOS it ignores TMPDIR. %/ drops TMPDIR's trailing slash.
  local OMAMAC_LOG tmp=${TMPDIR:-/tmp} before after n
  OMAMAC_LOG=$(mktemp "${tmp%/}/omamac-pull.XXXXXX")
  before=$(git -C "$OMAMAC_HOME" rev-parse HEAD 2>/dev/null) || before=''
  if ! GIT_TERMINAL_PROMPT=0 ui_run "Updating omamac" git -C "$OMAMAC_HOME" pull --ff-only; then
    if ui_term; then
      OMAMAC_STEP="updating omamac's code"
      ui_stopped "${fix#*Fix: }"
    else
      ui_fail "$fix"
    fi
    return 1
  fi
  rm -f "$OMAMAC_LOG"
  # The terminal look: update.sh's first stage row says what the pull brought.
  # An older update.sh ignores it.
  if ui_term; then
    after=$(git -C "$OMAMAC_HOME" rev-parse HEAD 2>/dev/null) || after=''
    n=0
    [ -z "$before" ] || [ "$before" = "$after" ] || n=$(git -C "$OMAMAC_HOME" rev-list --count "$before..$after" 2>/dev/null) || n=0
    case $n in
      0) OMAMAC_PULLED='already up to date' ;;
      1) OMAMAC_PULLED='pulled 1 commit' ;;
      *) OMAMAC_PULLED="pulled $n commits" ;;
    esac
    export OMAMAC_PULLED
  fi
  exec "$OMAMAC_BREW_PREFIX/bin/bash" "$OMAMAC_HOME/update.sh"
}

omamac_main() {
  # No command: the menu where it can ask, the usage text anywhere else.
  if [ "$#" -eq 0 ]; then
    if ui_term && ask_has_tty; then menu_run; else omamac_usage; fi
    return
  fi
  local cmd=$1 name
  case "$cmd" in
    help | -h | --help) omamac_usage ;;
    doctor)
      if [ "$#" -gt 2 ] || { [ "$#" -eq 2 ] && [ "$2" != --all ]; }; then
        omamac_usage >&2
        return 2
      fi
      # Its Reinstall offers ask; a broken prompt then names omamac doctor.
      OMAMAC_CMD=doctor
      doctor_run "${@:2}"
      ;;
    update) omamac_update ;;
    install)
      OMAMAC_CMD=install
      trap omamac_failed ERR
      for name in "${@:2}"; do configure_refuse "$name"; done
      omamac_choices
      shift
      add_run "$@"
      ;;
    uninstall)
      if [ "$#" -gt 2 ]; then
        omamac_usage >&2
        return 2
      fi
      OMAMAC_CMD=uninstall
      trap omamac_failed ERR
      [ "$#" -lt 2 ] || { remove_refuse_core "$2"; configure_refuse "$2"; }
      omamac_choices
      remove_run "${@:2}"
      ;;
    configure)
      if [ "$#" -gt 3 ] || { [ "$#" -eq 3 ] && [ "$3" != on ] && [ "$3" != off ]; }; then
        omamac_usage >&2
        return 2
      fi
      OMAMAC_CMD=configure
      trap omamac_failed ERR
      omamac_choices
      configure_run "${@:2}"
      ;;
    theme)
      if [ "$#" -gt 2 ]; then
        omamac_usage >&2
        return 2
      fi
      OMAMAC_CMD=theme
      trap omamac_failed ERR
      omamac_choices
      theme_run "${@:2}"
      ;;
    *)
      echo "Unknown command: $cmd" >&2
      omamac_usage >&2
      return 2
      ;;
  esac
}

omamac_main "$@"
